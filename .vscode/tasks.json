{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri: dev",
      "type": "shell",
      "command": "npm run tauri dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "tauri: build",
      "type": "shell",
      "command": "npm run tauri build",
      "problemMatcher": []
    },
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "vite: dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "(.*)", "file": 1, "location": 1, "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "cargo: build debug",
      "type": "shell",
      "command": "cargo build",
      "options": { "cwd": "${workspaceFolder}/src-tauri" },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "debug: prepare",
      "dependsOn": ["vite: dev server", "cargo: build debug"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
